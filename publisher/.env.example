SITE_NAME=Detailz
SITE_URL=https://yourdomain.com
SITE_BASE_PATH=
NEWS_BASE_PATH=/news
SITE_TAGLINE=Celebrity news with photos, rewritten for Detailz readers.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SYNC_INTERVAL_SECONDS=180
ENRICH_BATCH_SIZE=8
PUSH_INTERVAL_HOURS=2

# github = push site/ to Git; Cloudflare Pages pulls from Git
DEPLOY_TARGET=github
CLOUDFLARE_PAGES_PROJECT=detailz
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

REPO_ROOT=C:\Users\PC\Desktop\ab
EXPORT_DIR=

GOOGLE_SITE_VERIFICATION=

# Optional: Bing/Yandex fast indexing (https://www.indexnow.org/)
# Same value as GitHub secret INDEXNOW_KEY and /{key}.txt on site root
INDEXNOW_KEY=b4f17932-fd25-4924-88e4-c1dca75c6951